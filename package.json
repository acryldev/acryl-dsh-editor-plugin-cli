{
  "name": "acryl-dsh-editor-plugin-cli",
  "version": "0.2.1",
  "description": "DSH TUI plugin: a native /files command - browse, view, and edit files from acryl-cli's own terminal UI.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acryl-dsh-editor-plugin-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "acryl-package",
    "dsh-plugin",
    "dsh",
    "editor",
    "tui",
    "cli"
  ],
  "acryl": {
    "schemaVersion": 1,
    "artifacts": {
      "plugins": [
        "./lib/index.js"
      ]
    },
    "surfaces": ["tui"]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
